generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Task {
  id        String   @id @default(cuid())
  name      String
  desc      String
  priority  Int
  time      Int
  deadline  DateTime
  link      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id        String   @id @default(cuid())
  name      String
  desc      String
  frequency Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Study {
  id        String   @id @default(cuid())
  class     String
  content   String
  liked     Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  name      String
  type      String
  price     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Project {
  id        String   @id @default(cuid())
  name      String
  desc      String
  type      String
  link      String
  github    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
